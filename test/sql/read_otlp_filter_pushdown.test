# name: test/sql/read_otlp_filter_pushdown.test
# description: filters pushed into the readers return exactly what DuckDB's own evaluation does
# group: [sql]

require otlp

# Generated by scripts/gen_filter_pushdown_test.py: every query runs twice, once against the reader
# (filters pushed into otlp2records and applied by the scan) and once against a table copy of the same
# data (filters evaluated by DuckDB). The two must agree row for row, and the count pins how many rows
# the filter keeps.

statement ok
CREATE TABLE traces AS SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb');

statement ok
CREATE TABLE logs AS SELECT * FROM read_otlp_logs('external/otlp2records/testdata/logs_large.pb');

statement ok
CREATE TABLE small AS SELECT * FROM read_otlp_logs(['test/data/logs_simple.jsonl', 'test/data/logs_nulls.jsonl', 'test/data/ts_boundary_logs.jsonl', 'test/data/otlp_logs.pb']);

statement ok
CREATE TABLE gauge AS SELECT * FROM read_otlp_metrics_gauge('external/otlp2records/testdata/metrics_mixed.pb');

statement ok
CREATE TABLE histogram AS SELECT * FROM read_otlp_metrics_histogram('external/otlp2records/testdata/metrics_mixed.pb');

statement ok
CREATE TABLE otap_traces AS SELECT * FROM read_otap_traces('test/data/otap/traces-initial.bar');

statement ok
CREATE TABLE otap_logs AS SELECT * FROM read_otap_logs(['test/data/otap/logs-initial.bar', 'test/data/otap/logs-zstd.bar']);

# equality on service_name
query II
SELECT ((SELECT count(*) FROM (SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name = 'cart' EXCEPT ALL SELECT * FROM traces WHERE service_name = 'cart')) + (SELECT count(*) FROM (SELECT * FROM traces WHERE service_name = 'cart' EXCEPT ALL SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name = 'cart'))), (SELECT count(*) FROM (SELECT * FROM traces WHERE service_name = 'cart'));
----
0	334

# IN on service_name
query II
SELECT ((SELECT count(*) FROM (SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name IN ('cart', 'kafka') EXCEPT ALL SELECT * FROM traces WHERE service_name IN ('cart', 'kafka'))) + (SELECT count(*) FROM (SELECT * FROM traces WHERE service_name IN ('cart', 'kafka') EXCEPT ALL SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name IN ('cart', 'kafka')))), (SELECT count(*) FROM (SELECT * FROM traces WHERE service_name IN ('cart', 'kafka')));
----
0	650

# OR of equalities
query II
