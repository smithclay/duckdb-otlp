# OR with IS NULL cannot prune
query II
SELECT ((SELECT count(*) FROM (SELECT * FROM read_otlp_logs(['test/data/logs_simple.jsonl', 'test/data/logs_nulls.jsonl', 'test/data/ts_boundary_logs.jsonl', 'test/data/otlp_logs.pb']) WHERE time_unix_nano < '2021-06-01' OR time_unix_nano IS NULL EXCEPT ALL SELECT * FROM small WHERE time_unix_nano < '2021-06-01' OR time_unix_nano IS NULL)) + (SELECT count(*) FROM (SELECT * FROM small WHERE time_unix_nano < '2021-06-01' OR time_unix_nano IS NULL EXCEPT ALL SELECT * FROM read_otlp_logs(['test/data/logs_simple.jsonl', 'test/data/logs_nulls.jsonl', 'test/data/ts_boundary_logs.jsonl', 'test/data/otlp_logs.pb']) WHERE time_unix_nano < '2021-06-01' OR time_unix_nano IS NULL))), (SELECT count(*) FROM (SELECT * FROM small WHERE time_unix_nano < '2021-06-01' OR time_unix_nano IS NULL));
----
0	1

