# Filters DuckDB creates while running: a TopN's threshold and a join's keys arrive as dynamic or
# optional filters. The scan prunes by what it understands of them and must still agree.
query I
SELECT (SELECT list(span_id ORDER BY start_time_unix_nano) FROM (SELECT * FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') ORDER BY start_time_unix_nano DESC LIMIT 7))
     = (SELECT list(span_id ORDER BY start_time_unix_nano) FROM (SELECT * FROM traces ORDER BY start_time_unix_nano DESC LIMIT 7));
----
true

statement ok
CREATE TABLE wanted AS SELECT * FROM (VALUES ('cart'), ('kafka')) v(name);

query II
SELECT (SELECT count(*) FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') r JOIN wanted ON r.service_name = wanted.name),
       (SELECT count(*) FROM traces JOIN wanted ON traces.service_name = wanted.name);
----
650	650

# A collation changes what equality means, so a collated comparison is never pruned as a byte match.
query I
SELECT count(*) FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name = 'CART' COLLATE NOCASE;
----
334

statement ok
SET default_collation = 'nocase';

query I
SELECT count(*) FROM read_otlp_traces('external/otlp2records/testdata/traces_large.pb') WHERE service_name = 'CART';
----
334

statement ok
RESET default_collation;
