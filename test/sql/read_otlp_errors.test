# name: test/sql/read_otlp_errors.test
# description: OTLP file discovery and parse failures
# group: [sql]

require otlp

foreach signal traces logs

statement error
SELECT * FROM read_otlp_{signal}('nonexistent_file.jsonl');
----
No files found that match the pattern

statement error
SELECT * FROM read_otlp_{signal}('test/data/malformed.jsonl');
----
OTLP parse error on test/data/malformed.jsonl: Parse failed

endloop

# Malformed input also fails when no columns are projected.
statement error
SELECT COUNT(*) FROM read_otlp_traces('test/data/malformed.jsonl');
----
OTLP parse error on test/data/malformed.jsonl: Parse failed

# A glob that matches a valid and a malformed file reports the bad file.
query I
SELECT COUNT(*) FROM read_otlp_traces('test/data/multifile_valid_traces.jsonl');
----
1

foreach file multifile_malformed_traces.jsonl multifile_*.jsonl

statement error
SELECT COUNT(*) FROM read_otlp_traces('test/data/{file}');
----
OTLP parse error on test/data/multifile_malformed_traces.jsonl: Parse failed

endloop
