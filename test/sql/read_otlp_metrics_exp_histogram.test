# name: test/sql/read_otlp_metrics_exp_histogram.test
# description: Read exponential histograms and skip unsupported summary data points
# group: [sql]

require otlp

foreach file metrics_all_types.jsonl metrics_exp_histogram_ndjson.jsonl

query I
SELECT COUNT(*) FROM read_otlp_metrics_exp_histogram('test/data/{file}');
----
1

query TIIIRRRIITT
SELECT name, scale, count, zero_count, sum, min, max, positive_offset, negative_offset, service_name, unit
FROM read_otlp_metrics_exp_histogram('test/data/{file}');
----
latency.exp	3	12	1	45.5	1.0	9.5	2	-1	test-service	ms

endloop

statement ok
SELECT * FROM read_otlp_metrics_exp_histogram('test/data/metrics_simple.jsonl');

foreach file metrics_simple.jsonl logs_simple.jsonl

query I
SELECT COUNT(*) FROM read_otlp_metrics_exp_histogram('test/data/{file}');
----
0

endloop

foreach shape gauge sum histogram exp_histogram

query I
SELECT COUNT(*) FROM read_otlp_metrics_{shape}('test/data/metrics_summary_only.jsonl');
----
0

endloop
