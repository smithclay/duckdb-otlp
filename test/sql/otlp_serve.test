# name: test/sql/otlp_serve.test
# description: Test ingest server lifecycle SQL functions
# group: [sql]

#
# Coverage note: SQLLogicTest cannot issue HTTP POSTs, so this file covers only
# the lifecycle/bind surface (serve/list/stop, validation, hostname gating,
# schema/column validation). The ingest hot
# path -- auth (Bearer/x-api-key), content-type/encoding errors, 413, 503
# backpressure, metrics fan-out and the drain on stop -- is exercised end-to-end
# against the daemon by test/server/test_server_ingest.py.

require otlp

# The live ingest functions are registered only on native builds. The supported
# native builds are 64-bit, so this also skips the file in the wasm32 runner.
require 64bit

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'short');
----
OTLP server token must be at least 16 characters long

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456', seal_target_bytes := 0);
----
seal_target_bytes must be greater than zero

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456', seal_max_age_ms := 0);
----
seal_max_age_ms must be greater than zero

statement error
CALL otlp_flush('otlp:127.0.0.1:55439', checkpoint := true);
----
Invalid named parameter "checkpoint"

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456', catalog_maintenance_interval := 1);
----
Invalid named parameter "catalog_maintenance_interval"

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456', checkpoint_interval := 1);
----
Invalid named parameter "checkpoint_interval"

query TTTTTT
SELECT *
FROM otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456', schema := 'main', create_tables := true,
                seal_target_bytes := 1048576, seal_max_age_ms := 2500, maintenance_interval_ms := 600000);
----
otlp:127.0.0.1:55439	http://127.0.0.1:55439	dev-token-123456	main	(empty)	http

statement error
CALL otlp_serve('otlp:127.0.0.1:55439', token := 'dev-token-123456');
----
OTLP server already exists

query TTI
SELECT listen_uri, schema_name, total_requests
FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55439';
----
otlp:127.0.0.1:55439	main	0

statement ok
PREPARE list_servers AS SELECT count(*) FROM otlp_server_list();

query I
EXECUTE list_servers;
----
1

query I
EXECUTE list_servers;
----
1

statement ok
DEALLOCATE list_servers;

# a freshly-started server is listed
query I
SELECT count(*) FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55439';
----
1

# a server started without a catalog targets the default catalog (empty catalog_name)
query I
SELECT count(*) FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55439' AND catalog_name = '';
----
1

# a freshly-started server has an empty buffer and has never sealed
query I
SELECT count(*) FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55439'
  AND buffered_rows = 0 AND buffered_bytes = 0 AND admitted_bytes = 0
  AND seal_target_bytes = 1048576 AND seal_max_age_ms = 2500
  AND oldest_buffered_age_ms IS NULL AND seals_total = 0
  AND committed_rows_total = 0
  AND last_seal_age_ms IS NULL AND seal_last_error IS NULL
  AND maintenance_runs_total = 0 AND maintenance_failures_total = 0
  AND last_maintenance_age_ms IS NULL AND maintenance_last_error IS NULL;
----
1

# flushing a server with nothing buffered seals zero rows, no error
query TI
SELECT status, sealed_rows FROM otlp_flush('otlp:127.0.0.1:55439');
----
sealed	0

statement ok
PREPARE flush_server AS SELECT status, sealed_rows FROM otlp_flush('otlp:127.0.0.1:55439');

query TI
EXECUTE flush_server;
----
sealed	0

query TI
EXECUTE flush_server;
----
sealed	0

statement ok
DEALLOCATE flush_server;

# Both actions reject an unknown listen URI.
statement error
SELECT status FROM otlp_flush('otlp:127.0.0.1:59999');
----
Invalid Input Error: No server found listening on otlp:127.0.0.1:59999

statement error
SELECT status FROM otlp_stop('otlp:127.0.0.1:59999');
----
Invalid Input Error: No server found listening on otlp:127.0.0.1:59999

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55439');
----
Stopped listening on otlp:127.0.0.1:55439

query I
SELECT count(*) FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55439';
----
0

# disable_auth opt-in: anonymous serve mints no token (auth_token is empty) and
# skips the >= 16 char token floor. Used by tokenless producers (e.g. the
# otel-arrow OTAP exporter, which cannot attach a bearer token).
query TT
SELECT listen_uri, auth_token
FROM otlp_serve('otlp:127.0.0.1:55445', transport := 'grpc', disable_auth := true);
----
otlp:127.0.0.1:55445	(empty)

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55445');
----
Stopped listening on otlp:127.0.0.1:55445

# disable_auth coexists with an explicitly supplied (and intentionally short) token
# without tripping the token-length floor, since auth is off.
query T
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55446', transport := 'grpc', disable_auth := true, token := 'x');
----
otlp:127.0.0.1:55446

statement ok
CALL otlp_stop('otlp:127.0.0.1:55446');

# non-localhost binds require allow_other_hostname (rejected before binding a socket)
statement error
CALL otlp_serve('otlp:0.0.0.0:55440', token := 'dev-token-123456');
----
Only localhost is allowed

# create_tables := false against a schema with no OTLP tables fails fast
statement error
CALL otlp_serve('otlp:127.0.0.1:55441', token := 'dev-token-123456', schema := 'no_such_schema', create_tables := false);
----
is not available

# max_body_bytes must be positive
statement error
CALL otlp_serve('otlp:127.0.0.1:55442', token := 'dev-token-123456', max_body_bytes := 0);
----
max_body_bytes must be greater than zero

statement error
CALL otlp_serve('otlp:127.0.0.1:55454', token := 'dev-token-123456', max_buffered_bytes := 0);
----
max_buffered_bytes must be greater than zero

# schema must not be empty
statement error
CALL otlp_serve('otlp:127.0.0.1:55443', token := 'dev-token-123456', schema := '');
----
schema must not be empty

# create_tables := false succeeds when the target tables already exist (created above)
query TTT
SELECT listen_uri, listen_url, schema_name
FROM otlp_serve('otlp:127.0.0.1:55444', token := 'dev-token-123456', schema := 'main', create_tables := false);
----
otlp:127.0.0.1:55444	http://127.0.0.1:55444	main

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55444');
----
Stopped listening on otlp:127.0.0.1:55444

# --- gRPC transport control plane ---
# The daemon tests exercise OTLP exports and OTAP streams on the same gRPC port.
query T
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55461', token := 'dev-token-123456', transport := 'grpc');
----
otlp:127.0.0.1:55461

query I
SELECT count(*) FROM otlp_server_list()
WHERE listen_uri = 'otlp:127.0.0.1:55461' AND transport = 'grpc';
----
1

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55461');
----
Stopped listening on otlp:127.0.0.1:55461

# An unsupported scheme is rejected before binding.
statement error
SELECT listen_uri FROM otlp_serve('otap:127.0.0.1:55462', token := 'dev-token-123456');
----
Invalid OTLP listen URI, needs to start with 'otlp:'

# transport accepts only http/grpc.
statement error
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55464', token := 'dev-token-123456', transport := 'bogus');
----
transport must be 'http' or 'grpc'

# --- one server, N listeners ---
# otlp_serve takes a list of listen URIs with a parallel transport list. Every listener
# feeds one server: one buffer set, one admission cap, one sealer, one maintenance schedule.
query TTT
SELECT listen_uri, listen_url, transport
FROM otlp_serve(['otlp:127.0.0.1:55470', 'otlp:127.0.0.1:55471'], transport := ['http', 'grpc'],
                token := 'dev-token-123456', seal_target_bytes := 1048576)
ORDER BY listen_uri;
----
otlp:127.0.0.1:55470	http://127.0.0.1:55470	http
otlp:127.0.0.1:55471	http://127.0.0.1:55471	grpc

# one row per listener, sharing the server-wide seal settings and counters
query TTII
SELECT listen_uri, transport, seal_target_bytes, seals_total
FROM otlp_server_list()
ORDER BY listen_uri;
----
otlp:127.0.0.1:55470	http	1048576	0
otlp:127.0.0.1:55471	grpc	1048576	0

# a flush through either listener reaches the one shared server
query T
SELECT status FROM otlp_flush('otlp:127.0.0.1:55471');
----
sealed

query T
SELECT status FROM otlp_flush();
----
sealed

# a second server for the same catalog + schema is rejected: a target has one writer
statement error
CALL otlp_serve('otlp:127.0.0.1:55472', token := 'dev-token-123456');
----
pass every listen URI to one otlp_serve call

# a listen URI already owned by the server is rejected
statement error
CALL otlp_serve('otlp:127.0.0.1:55471', token := 'dev-token-123456', schema := 'other_schema');
----
OTLP server already exists for otlp:127.0.0.1:55471

# Another server remains registered when the first server is stopped via its second listener.
statement ok
CREATE SCHEMA stop_all_other;

statement ok
CALL otlp_serve('otlp:127.0.0.1:55482', token := 'dev-token-123456', schema := 'stop_all_other');

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55471');
----
Stopped listening on otlp:127.0.0.1:55470, otlp:127.0.0.1:55471

query T
SELECT listen_uri FROM otlp_server_list();
----
otlp:127.0.0.1:55482

statement ok
CALL otlp_stop('otlp:127.0.0.1:55482');

query I
SELECT count(*) FROM otlp_server_list();
----
0

# a scalar transport applies to every listed URI
query TT
SELECT listen_uri, transport
FROM otlp_serve(['otlp:127.0.0.1:55473', 'otlp:127.0.0.1:55474'], transport := 'grpc',
                token := 'dev-token-123456')
ORDER BY listen_uri;
----
otlp:127.0.0.1:55473	grpc
otlp:127.0.0.1:55474	grpc

statement ok
CALL otlp_stop('otlp:127.0.0.1:55473');

# a transport list must match the URI list
statement error
CALL otlp_serve(['otlp:127.0.0.1:55475', 'otlp:127.0.0.1:55476'], transport := ['http', 'grpc', 'http'],
                token := 'dev-token-123456');
----
one entry per listen URI

# listen URIs must be distinct
statement error
CALL otlp_serve(['otlp:127.0.0.1:55477', 'otlp:127.0.0.1:55477'], token := 'dev-token-123456');
----
must be distinct

# the scheme check applies to every URI in the list
statement error
CALL otlp_serve(['otlp:127.0.0.1:55478', 'otap:127.0.0.1:55479'], token := 'dev-token-123456');
----
Invalid OTLP listen URI, needs to start with 'otlp:'

statement error
CALL otlp_serve([]::VARCHAR[], token := 'dev-token-123456');
----
requires at least one listen URI

# maintenance_contended_total is a trailing otlp_server_list column; a fresh server has none
statement ok
CALL otlp_serve('otlp:127.0.0.1:55480', token := 'dev-token-123456');

query I
SELECT maintenance_contended_total FROM otlp_server_list() WHERE listen_uri = 'otlp:127.0.0.1:55480';
----
0

statement ok
CALL otlp_stop('otlp:127.0.0.1:55480');

# --- otlp_flush() and otlp_stop(): act on every server on the instance ---
#
# This is what the daemon's shutdown runs. The single-URI form only reaches the server it
# names, so a server started out-of-band (over Quack, or by the daemon's --init-sql script)
# used to survive to database teardown -- where OtlpServer::db_ptr has already expired, the
# final seal is a silent no-op, and its buffered rows are dropped. Covered here because the
# loss is invisible from the URI form's own result.

# no servers: one informational row rather than an empty result, so the caller is never
# left guessing whether the stop ran.
query TI
SELECT status, dropped_rows FROM otlp_stop();
----
No OTLP servers are running	0

query TIIT
SELECT * FROM otlp_flush();
----
No OTLP servers are running	0	0	NULL

statement ok
CALL otlp_serve('otlp:127.0.0.1:55481', token := 'dev-token-123456');

# a second server: a distinct target (schema), which is what the one-server-per-target rule
# requires, standing in for the out-of-band server the daemon does not know about.
statement ok
CALL otlp_serve('otlp:127.0.0.1:55482', token := 'dev-token-123456', schema := 'stop_all_other');

query I
SELECT count(*) FROM otlp_server_list();
----
2

query TIIT
SELECT * FROM otlp_flush();
----
sealed	0	0	NULL
sealed	0	0	NULL

# one row per server, and no rows dropped: both were sealed while the database was alive.
query I
SELECT count(*) FROM otlp_stop() WHERE status LIKE 'Stopped listening on%' AND dropped_rows = 0;
----
2

query I
SELECT count(*) FROM otlp_server_list();
----
0

# the registry stays usable: a graceful stop-all is not teardown, so otlp_serve still works.
statement ok
CALL otlp_serve('otlp:127.0.0.1:55483', token := 'dev-token-123456');

query I
SELECT count(*) FROM otlp_stop();
----
1

# CASCADE: serve created the six ingest tables in this schema.
statement ok
DROP SCHEMA stop_all_other CASCADE;
