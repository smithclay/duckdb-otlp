# name: test/sql/otlp_serve_variant.test
# description: attributes_as_variant shapes the ingest server's destination tables
# group: [sql]

require otlp

# Same reason as otlp_serve.test: the ingest server is native-only.
require 64bit

query T
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55471', token := 'dev-token-123456',
                                  attributes_as_variant := true);
----
otlp:127.0.0.1:55471

# The server creates its destination tables with VARIANT bags; every other column is untouched.
query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'otlp_logs'
  AND column_name IN ('resource_attributes', 'scope_attributes', 'log_attributes', 'body')
ORDER BY column_name;
----
body	VARCHAR
log_attributes	VARIANT
resource_attributes	VARIANT
scope_attributes	VARIANT

query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'otlp_traces' AND column_name IN ('span_attributes', 'events_json')
ORDER BY column_name;
----
events_json	VARCHAR
span_attributes	VARIANT

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55471');
----
Stopped listening on otlp:127.0.0.1:55471

# Restarting against those tables without the flag is a startup error naming the migration,
# not a silent write of JSON text into a VARIANT column.
statement error
CALL otlp_serve('otlp:127.0.0.1:55471', token := 'dev-token-123456');
----
was created with attributes_as_variant := true

# The flag is what reconciles them.
query T
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55471', token := 'dev-token-123456',
                                  attributes_as_variant := true);
----
otlp:127.0.0.1:55471

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55471');
----
Stopped listening on otlp:127.0.0.1:55471

# Promotion rides on the VARIANT bags too: the promoted columns stay VARCHAR. (A server does
# not create its schema -- only the daemon's generated boot SQL does -- so create it here.)
statement ok
CREATE SCHEMA promoted;

query T
SELECT listen_uri FROM otlp_serve('otlp:127.0.0.1:55472', token := 'dev-token-123456',
                                  schema := 'promoted', attributes_as_variant := true,
                                  promote_resource_attributes := 'service.name');
----
otlp:127.0.0.1:55472

query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'otlp_logs' AND schema_name = 'promoted'
  AND column_name IN ('resource_attributes', 'resource_attr_service_name')
ORDER BY column_name;
----
resource_attr_service_name	VARCHAR
resource_attributes	VARIANT

query T
SELECT status FROM otlp_stop('otlp:127.0.0.1:55472');
----
Stopped listening on otlp:127.0.0.1:55472
