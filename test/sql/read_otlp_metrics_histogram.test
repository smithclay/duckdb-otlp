# name: test/sql/read_otlp_metrics_histogram.test
# description: Read histograms in mixed and histogram-only NDJSON files
# group: [sql]

require otlp

foreach file metrics_all_types.jsonl metrics_histogram_ndjson.jsonl

query I
SELECT COUNT(*) FROM read_otlp_metrics_histogram('test/data/{file}');
----
1

query TTTIRTTTTTT
SELECT name, description, unit, count, sum, bucket_counts, explicit_bounds, service_name, metric_attributes,
       typeof(count), typeof(bucket_counts)
FROM read_otlp_metrics_histogram('test/data/{file}');
----
latency.hist	Latency	ms	50	250.0	[5, 10, 15, 12, 8]	[5.0, 10.0, 20.0, 50.0]	test-service	{"endpoint":"/health"}	BIGINT	BIGINT[]

endloop

# metrics_simple.jsonl also contains a histogram.
statement ok
SELECT * FROM read_otlp_metrics_histogram('test/data/metrics_simple.jsonl');

query I
SELECT COUNT(*) FROM read_otlp_metrics_histogram('test/data/metrics_simple.jsonl');
----
1

query I
SELECT COUNT(*) FROM read_otlp_metrics_histogram('test/data/logs_simple.jsonl');
----
0
